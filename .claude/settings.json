{
	"hooks": {
		"SessionStart": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.mjs\"",
						"timeout": 900
					}
				]
			}
		],
		"PreToolUse": [
			{
				"matcher": "Skill|mcp__github__add_comment_to_pending_review|mcp__github__pull_request_review_write",
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/review-guard.mjs\""
					}
				]
			},
			{
				"matcher": "Read|Bash",
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/delegate-read.mjs\""
					}
				]
			},
			{
				"matcher": "Bash|mcp__github__.*",
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/git-guard.mjs\""
					}
				]
			},
			{
				"matcher": "Bash",
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/verify-guard.mjs\""
					}
				]
			},
			{
				"matcher": "mcp__github__(create|update)_pull_request",
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/pr-guard.mjs\"",
						"timeout": 600
					}
				]
			}
		],
		"PostToolUse": [
			{
				"matcher": "Read",
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop-guard.mjs\""
					}
				]
			},
			{
				"matcher": "mcp__.*__(create_pull_request|subscribe_pr_activity|set_session_title|create_session)",
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/pr-followup.mjs\""
					}
				]
			}
		],
		"Stop": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop-guard.mjs\""
					},
					{
						"type": "command",
						"command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/pr-followup.mjs\""
					}
				]
			}
		],
		"PostToolUse": [
			{
				"matcher": "mcp__github__add_comment_to_pending_review|mcp__github__pull_request_review_write",
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/review-guard.mjs\""
					}
				]
			}
		]
	}
}
