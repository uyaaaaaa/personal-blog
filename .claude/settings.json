{
	"deniedMcpServers": [
		{ "serverName": "Gmail" },
		{ "serverName": "Slack" },
		{ "serverName": "Linear" },
		{ "serverName": "Google_Drive" },
		{ "serverName": "Google_Calendar" },
		{ "serverName": "Cloudflare_Developer_Platform" }
	],
	"permissions": {
		"allow": [
			"Bash(git status)",
			"Bash(git status:*)",
			"Bash(git diff:*)",
			"Bash(git log:*)",
			"Bash(git show:*)",
			"Bash(git branch:*)",
			"Bash(git fetch origin:*)",
			"Bash(git checkout -b claude/:*)",
			"Bash(git add:*)",
			"Bash(git commit:*)",
			"Bash(git push -u origin claude/:*)",
			"Bash(npm ci)",
			"Bash(npm test)",
			"Bash(node scripts/article-files.mjs:*)",
			"Bash(node scripts/article-routes.mjs:*)",
			"Bash(node scripts/harness-journal.mjs:*)",
			"Bash(node scripts/issue-shape.mjs:*)",
			"Bash(node scripts/overlay-probe.mjs:*)",
			"Bash(node scripts/review-args.mjs:*)",
			"Bash(node scripts/session-args.mjs:*)",
			"Bash(node scripts/session-cost.mjs:*)",
			"Bash(node scripts/touches-code.mjs:*)",
			"mcp__github__pull_request_read",
			"mcp__github__get_file_contents",
			"mcp__github__issue_read",
			"mcp__github__list_issues",
			"mcp__github__actions_list",
			"mcp__github__actions_get",
			"mcp__github__get_check_run",
			"mcp__github__get_job_logs",
			"mcp__github__subscribe_pr_activity",
			"mcp__Claude_Code_Remote__set_session_title",
			"mcp__Claude_Code_Remote__get_session"
		]
	},
	"hooks": {
		"UserPromptSubmit": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/dispatch-guard.mjs\""
					}
				]
			}
		],
		"SessionStart": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.mjs\"",
						"timeout": 900
					}
				]
			}
		],
		"PreToolUse": [
			{
				"matcher": "Bash|mcp__.*(pull_request_review|actions_run_trigger|add_issue_comment|update_issue_comment|add_comment_to_pending_review|add_reply_to_pull_request_comment)",
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/review-guard.mjs\""
					}
				]
			},
			{
				"matcher": "Read|Bash",
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/delegate-read.mjs\""
					}
				]
			},
			{
				"matcher": "Bash|mcp__github__.*",
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/git-guard.mjs\""
					}
				]
			},
			{
				"matcher": "Bash",
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/verify-guard.mjs\""
					}
				]
			},
			{
				"matcher": "mcp__github__(create|update)_pull_request",
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/pr-guard.mjs\"",
						"timeout": 600
					}
				]
			},
			{
				"matcher": "mcp__github__issue_write",
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/issue-guard.mjs\""
					}
				]
			},
			{
				"matcher": "mcp__.*__(create_session|slack_send_message|slack_send_message_draft|slack_schedule_message)",
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/dispatch-guard.mjs\""
					}
				]
			}
		],
		"PostToolUse": [
			{
				"matcher": "Read",
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop-guard.mjs\""
					}
				]
			},
			{
				"matcher": "Bash|mcp__.*__(create_pull_request|subscribe_pr_activity|set_session_title|actions_run_trigger)",
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/pr-followup.mjs\""
					}
				]
			},
			{
				"matcher": "Bash|mcp__.*actions_run_trigger",
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/review-guard.mjs\""
					}
				]
			},
			{
				"matcher": "mcp__.*__(create_session|slack_send_message|slack_send_message_draft|slack_schedule_message)",
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/dispatch-guard.mjs\""
					}
				]
			}
		],
		"Stop": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop-guard.mjs\""
					},
					{
						"type": "command",
						"command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/pr-followup.mjs\""
					}
				]
			}
		]
	}
}
