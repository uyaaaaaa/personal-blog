{
	"hooks": {
		"UserPromptSubmit": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/dispatch-guard.mjs\""
					}
				]
			}
		],
		"SessionStart": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.mjs\"",
						"timeout": 900
					}
				]
			}
		],
		"PreToolUse": [
			{
				"matcher": "Skill|Bash|mcp__.*(pull_request_review|actions_run_trigger|add_issue_comment|update_issue_comment|add_comment_to_pending_review|add_reply_to_pull_request_comment)",
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/review-guard.mjs\""
					}
				]
			},
			{
				"matcher": "Read|Bash",
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/delegate-read.mjs\""
					}
				]
			},
			{
				"matcher": "Bash|mcp__github__.*",
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/git-guard.mjs\""
					}
				]
			},
			{
				"matcher": "Bash",
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/verify-guard.mjs\""
					}
				]
			},
			{
				"matcher": "mcp__github__(create|update)_pull_request",
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/pr-guard.mjs\"",
						"timeout": 600
					}
				]
			},
			{
				"matcher": "mcp__github__issue_write",
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/issue-guard.mjs\""
					}
				]
			},
			{
				"matcher": "mcp__.*__(create_session|slack_send_message|slack_send_message_draft|slack_schedule_message)",
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/dispatch-guard.mjs\""
					}
				]
			}
		],
		"PostToolUse": [
			{
				"matcher": "Read",
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop-guard.mjs\""
					}
				]
			},
			{
				"matcher": "mcp__.*__(create_pull_request|subscribe_pr_activity|set_session_title|create_session)",
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/pr-followup.mjs\""
					}
				]
			},
			{
				"matcher": "Bash|mcp__.*actions_run_trigger",
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/review-guard.mjs\""
					}
				]
			},
			{
				"matcher": "mcp__.*__(create_session|slack_send_message|slack_send_message_draft|slack_schedule_message)",
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/dispatch-guard.mjs\""
					}
				]
			}
		],
		"Stop": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop-guard.mjs\""
					},
					{
						"type": "command",
						"command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/pr-followup.mjs\""
					}
				]
			}
		]
	}
}
